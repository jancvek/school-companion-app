# Predloga za `apps/server/.env`. Prava datoteka NI v repozitoriju.
# Kopiraj v `.env` in izpolni.
#
# To datoteko prebere **Docker Compose**, da razreši `${DATABASE_URL}` in
# podobno, in vrednosti poda vsebniku prek `environment:`. Strežnik sam `.env`
# ne bere: `env_file` bi bil relativen na trenutno delovno mapo, zato bi se
# isti ukaz obnašal različno glede na to, od kod je pognan.
#
# Zato pri ročnem zagonu mimo Compose (razvoj) spremenljivke izvozi sam, npr.:
#   $env:DATABASE_URL = "..."; uvicorn app.main:create_app --factory
#
# Ime te datoteke ni `.env.primer`, kot je predvideval plan: dovoljenjska
# plast te seje zavrne pisanje vsake datoteke, ki se ujema z `.env*`.
# Vsebina je ista — sama imena spremenljivk, brez vrednosti.

# Povezava do Postgresa. V Docker Compose je gostitelj ime servisa `db`.
DATABASE_URL=postgresql+psycopg://solski:zamenjaj-me@db:5432/solski

# Geslo mora biti isto kot v DATABASE_URL — bere ga servis `db`.
POSTGRES_PASSWORD=zamenjaj-me

# Kam se zapisujejo slike znotraj vsebnika.
IMAGES_DIR=/data/images

# Ključ za OpenAI (vision obdelava, V1-R03). Dobiš ga na
# https://platform.openai.com/api-keys.
#
# Brez njega strežnik normalno steče in slike s telefona sprejema — ne teče
# samo obdelava. Slike ostanejo v stanju „čaka na obdelavo" in se obdelajo
# same, ko ključ vpišeš in strežnik zaženeš znova (`docs/odlocitve/ADR-009`).
OPENAI_API_KEY=

# Ime vision modela. Zamenjava novejšega je sprememba te vrstice in ponovni
# zagon — glej `docs/odlocitve/ADR-008`, ki pove tudi, kdaj se izbira pregleda
# znova.
OPENAI_MODEL=gpt-4.1

# Časovna omejitev enega klica modela, v sekundah. Obdelava teče zaporedno,
# zato bi klic brez omejitve ustavil vrsto za vse ostale slike.
OPENAI_TIMEOUT_SECONDS=120

# Razmik med obhodi obdelave, v sekundah.
WORKER_INTERVAL_SECONDS=30

# Domena, na kateri je strežnik dosegljiv prek HTTPS (V3-R02). Caddy zanjo
# pridobi certifikat. Brez nje se Caddy ne zažene.
#
# Od V3-R08 jo bere tudi `api`: iz nje nastane povratni naslov za Google, ki
# mora biti absoluten in enak tistemu v Googlovi konzoli.
DOMENA=school-buddy.duckdns.org

# Google prijava za starša (V3-R08). Dobiš ju v Google Cloud Console:
# APIs & Services → Credentials → Create credentials → OAuth client ID,
# tip „Web application". Pod „Authorized redirect URIs" vpiši **točno**
#   https://school-buddy.duckdns.org/auth/google/callback
# (brez končne poševnice; Google ujemanje zahteva znak za znak).
#
# Obsegi so samo `openid`, `email` in `profile` — nič drugega ne prosimo.
# Aplikacija ostane v načinu „Testing", kjer se lahko prijavijo samo ročno
# vpisani preizkusni računi (do 100). Za krog znancev je to dovolj in prihrani
# Googlovo preverjanje aplikacije; širši krog bi bil nova zahteva, ne popravek
# (`docs/odlocitve/ADR-025`).
#
# Brez teh dveh vrednosti strežnik normalno steče — samo gumba „Prijava z
# Google računom" ni in Googlove poti vrnejo 404 (`ADR-046` F). Prijava z
# geslom ne potrebuje ničesar od tega.
#
# Skrivnost odjemalca **ne sme v repozitorij**. Ta datoteka je predloga brez
# vrednosti; prava `.env` je v `.gitignore`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Spremenljivk ADMIN_UPORABNIK in ADMIN_ZGOSTITEV ni več (V3-R03): začasni
# `basic_auth` v Caddyju je padel, admin varuje prijava v aplikaciji sami
# (`docs/odlocitve/ADR-035`). Če sta v tvojem `.env` ostali, ju pobriši —
# nihče ju ne bere.
#
# Spremenljivke API_KEY ni več (V3-R04): en vgrajen ključ za vse družine je
# odpadel in telefon se odslej prijavi kot otrok, z žetonom iz iste tabele
# `sessions` kot brskalnik (`docs/odlocitve/ADR-027`, `ADR-036`). Če je v
# tvojem `.env` ostala, jo pobriši — nihče je ne bere.
#
# Nobeno geslo ni v tej datoteki in ne sme biti. Nastavi ju z ukazom v
# vsebniku, posebej za starša in posebej za otroka:
#   docker compose exec api python -m app.ukazi nastavi-geslo dejan.ambrus@gmail.com
#   docker compose exec api python -m app.ukazi nastavi-geslo masa
# Dokler geslo ni nastavljeno, prijava ne uspe — to je namerno. Otrokovo geslo
# mora biti vsaj 8 znakov (`ADR-036` E), staršev vsaj 12.

# Nastavitve naslova, na katerem posluša API, ni več: `api` nima vrat na
# gostitelju in je dosegljiv samo skozi Caddy (V3-R02). Stara vrstica
# `BIND_ADDRESS` se lahko iz `.env` pobriše; če ostane, se prezre.
